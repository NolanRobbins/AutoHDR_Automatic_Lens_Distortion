# Environment Variables Template
# Copy this file to .env and fill in your values

# Weights & Biases (for experiment tracking)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=lens-correction
WANDB_ENTITY=your_username

# Kaggle API (for data download)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Bounty Service (for evaluation)
BOUNTY_API_KEY=your_bounty_api_key_here
BOUNTY_URL=https://bounty.autohdr.com

# Paths (optional - defaults in configs)
DATA_DIR=data
OUTPUT_DIR=outputs
MODEL_DIR=outputs/models

# Device configuration
DEVICE=cuda  # or cpu
CUDA_VISIBLE_DEVICES=0

# Training (optional overrides)
BATCH_SIZE=8
NUM_WORKERS=4
